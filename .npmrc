# Zeego 3.x pins exact (older) peer versions for react-native-ios-context-menu /
# react-native-ios-utilities / @react-native-menu/menu. We intentionally use the
# newer stable releases (they add React Native 0.83 / new-architecture support), so
# allow npm to install despite the peer-range mismatch. Without this, CI `npm ci`
# fails with ERESOLVE.
legacy-peer-deps=true
